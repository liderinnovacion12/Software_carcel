# Copy this file to .env and adjust as needed for local/demo use.
# Never commit a real .env file.

# --- PostgreSQL ---
POSTGRES_USER=bialco
POSTGRES_PASSWORD=bialco_demo_password
POSTGRES_DB=bialco
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://bialco:bialco_demo_password@postgres:5432/bialco

# --- Redis (stubbed for this phase) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (stubbed for this phase) ---
MINIO_ROOT_USER=bialco_admin
MINIO_ROOT_PASSWORD=bialco_demo_password
MINIO_ENDPOINT=minio:9000

# --- Backend / Auth ---
JWT_SECRET=change_me_in_a_real_deployment_this_is_a_demo_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
